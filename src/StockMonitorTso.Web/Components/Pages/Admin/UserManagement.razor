@page "/admin/users"
@attribute [Authorize(Roles = "Superadmin")]
@rendermode InteractiveServer
@inject IUserAdminService UserAdmin
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using StockMonitorTso.Infrastructure.Persistence
@using StockMonitorTso.Infrastructure.Services

<PageTitle>Manajemen User</PageTitle>

<div class="sm-display-lg" style="margin-bottom:8px;">Manajemen User</div>
<div class="sm-body-md" style="margin-bottom:16px;">Buat user baru dan kelola role &amp; password. Hanya Superadmin.</div>

@if (message is not null)
{
    <div class="sm-alert @(messageIsError ? "sm-alert-error" : "sm-alert-success")">@message</div>
}<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <div class="sm-label-caps">Total @(users?.Count ?? 0) user</div>
    <button type="button" class="sm-btn sm-btn-primary" @onclick="OpenCreateModal">
        <span class="material-symbols-outlined" style="font-size:18px;">add</span>
        Tambah User
    </button>
</div>

@if (users is null)
{
    <div class="sm-card">Memuat…</div>
}
else
{
    <div class="sm-table-wrap">
        <table class="sm-table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Role Aktif</th>
                    <th>Role</th>
                    <th>Ganti Password</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    var roles = userRoles[u.Id];
                    <tr>
                        <td>@u.Email</td>
                        <td>
                            <span class="sm-pill sm-pill-neutral">@(string.IsNullOrEmpty(u.ActiveRoleName) ? "—" : u.ActiveRoleName)</span>
                        </td>
                        <td>
                            <div class="sm-segmented" style="max-width:360px;">
                                @foreach (var role in SeedRoles)
                                {
                                    var active = roles.Contains(role);
                                    <button type="button"
                                            class="@(active ? "active" : "")"
                                            @onclick="() => ToggleRole(u, role)">
                                        @role
                                    </button>
                                }
                            </div>
                        </td>
                        <td>
                            <div style="display:flex; gap:8px; align-items:center;">
                                <input type="password"
                                       class="sm-filter"
                                       style="flex:1; min-width:160px;"
                                       placeholder="Password baru"
                                       @bind="passwordInputs[u.Id]" />
                                <button type="button" class="sm-btn sm-btn-sm sm-btn-outline" @onclick="() => SetPassword(u)">
                                    Set
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showCreateModal)
{
    <div class="sm-modal-backdrop" @onclick="CloseCreateModal"></div>
    <div style="position:fixed;inset:0;z-index:110;display:flex;align-items:center;justify-content:center;overflow-y:auto;padding:24px 16px">
        <div class="sm-modal" role="dialog" aria-modal="true">
            <div class="sm-modal-header">
                <div class="sm-title-sm">Tambah User Baru</div>
                <button type="button" class="sm-btn sm-btn-sm sm-btn-outline" @onclick="CloseCreateModal">
                    <span class="material-symbols-outlined" style="font-size:18px;">close</span>
                </button>
            </div>
            <div class="sm-modal-body">
                <div style="display:flex; flex-direction:column; gap:14px;">
                    <div>
                        <label class="sm-label-caps" style="display:block; margin-bottom:4px;">Email</label>
                        <input type="email" class="sm-filter" style="width:100%;" placeholder="user@stockmonitor.local" @bind="createForm.Email" />
                    </div>
                    <div>
                        <label class="sm-label-caps" style="display:block; margin-bottom:4px;">Password</label>
                        <input type="password" class="sm-filter" style="width:100%;" placeholder="Minimal 8 karakter" @bind="createForm.Password" />
                    </div>
                    <div>
                        <label class="sm-label-caps" style="display:block; margin-bottom:4px;">Konfirmasi Password</label>
                        <input type="password" class="sm-filter" style="width:100%;" placeholder="Ulangi password" @bind="createForm.ConfirmPassword" />
                    </div>
                    <div>
                        <label class="sm-label-caps" style="display:block; margin-bottom:6px;">Role (pilih minimal satu)</label>
                        <div style="display:flex; flex-direction:column; gap:8px;">
                            @foreach (var role in SeedRoles)
                            {
                                var roleLocal = role;
                                var isChecked = createForm.SelectedRoles.Contains(roleLocal);
                                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                                    <input type="checkbox" checked="@isChecked" @onchange="e => OnCheckboxChanged(roleLocal, e)" />
                                    <span style="font-size:14px;">@roleLocal</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div>
                        <label class="sm-label-caps" style="display:block; margin-bottom:4px;">Role Aktif</label>
                        <select class="sm-filter" style="width:100%;" value="@createForm.ActiveRole" @onchange="OnActiveRoleChanged">
                            <option value="">— pilih role aktif —</option>
                            @foreach (var role in createForm.SelectedRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="sm-modal-footer">
                <button type="button" class="sm-btn sm-btn-outline" @onclick="CloseCreateModal">Batal</button>
                <button type="button" class="sm-btn sm-btn-primary" @onclick="SubmitCreateAsync" disabled="@isCreating">
                    @(isCreating ? "Menyimpan…" : "Buat User")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ApplicationUser>? users;
    private readonly Dictionary<string, HashSet<string>> userRoles = new();
    private readonly Dictionary<string, string> passwordInputs = new();
    private string? message;
    private bool messageIsError;

    private void SetMessage(string text, bool isError = false)
    {
        message = text;
        messageIsError = isError;
    }

    private static readonly string[] SeedRoles = ["Superadmin", "Operator", "Supervisi", "Tamu"];

    private bool showCreateModal;
    private bool isCreating;
    private CreateUserForm createForm = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        users = (await UserAdmin.ListUsersAsync()).ToList();
        foreach (var u in users)
        {
            userRoles[u.Id] = (await UserManager.GetRolesAsync(u)).ToHashSet();
            passwordInputs.TryAdd(u.Id, "");
        }
    }

    private async Task ToggleRole(ApplicationUser user, string role)
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var isInRole = userRoles[user.Id].Contains(role);
            if (isInRole)
            {
                await UserAdmin.RemoveRoleAsync(state.User, user.Id, role);
                SetMessage($"Role '{role}' dihapus dari {user.Email}.");
            }
            else
            {
                await UserAdmin.AssignRoleAsync(state.User, user.Id, role);
                SetMessage($"Role '{role}' diberikan ke {user.Email}.");
            }

            var refreshed = await UserManager.FindByIdAsync(user.Id);
            if (refreshed is not null && users is not null)
            {
                var index = users.FindIndex(u => u.Id == refreshed.Id);
                if (index >= 0)
                {
                    users[index] = refreshed;
                }
            }
            userRoles[user.Id] = (await UserManager.GetRolesAsync(refreshed ?? user)).ToHashSet();
            await InvokeAsync(StateHasChanged);
        }
        catch (UnauthorizedAccessException ex)
        {
            SetMessage(ex.Message, isError: true);
        }
    }

    private async Task SetPassword(ApplicationUser user)
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var newPassword = passwordInputs.GetValueOrDefault(user.Id);
            if (string.IsNullOrWhiteSpace(newPassword))
            {
                SetMessage("Password baru tidak boleh kosong.", isError: true);
                return;
            }

            await UserAdmin.SetPasswordAsync(state.User, user.Id, newPassword);
            passwordInputs[user.Id] = "";
            SetMessage($"Password {user.Email} berhasil diganti.");
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, isError: true);
        }
    }

    private void OpenCreateModal()
    {
        createForm = new CreateUserForm();
        showCreateModal = true;
        message = null;
        messageIsError = false;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        createForm = new CreateUserForm();
    }

    private void ToggleRoleCheckbox(string role, bool isChecked)
    {
        if (isChecked)
        {
            if (!createForm.SelectedRoles.Contains(role))
            {
                createForm.SelectedRoles.Add(role);
            }
        }
        else
        {
            createForm.SelectedRoles.Remove(role);
            if (createForm.ActiveRole == role)
            {
                createForm.ActiveRole = createForm.SelectedRoles.FirstOrDefault() ?? "";
            }
        }
    }

    private void OnActiveRoleChanged(ChangeEventArgs e)
    {
        createForm.ActiveRole = e.Value?.ToString() ?? "";
    }

    private void OnCheckboxChanged(string role, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        ToggleRoleCheckbox(role, isChecked);
    }

    private async Task SubmitCreateAsync()
    {
        if (isCreating)
        {
            return;
        }
        isCreating = true;
        try
        {
            if (string.IsNullOrWhiteSpace(createForm.Email))
            {
                SetMessage("Email wajib diisi.", isError: true);
                return;
            }
            if (string.IsNullOrWhiteSpace(createForm.Password))
            {
                SetMessage("Password wajib diisi.", isError: true);
                return;
            }
            if (createForm.Password != createForm.ConfirmPassword)
            {
                SetMessage("Konfirmasi password tidak cocok.", isError: true);
                return;
            }
            if (createForm.SelectedRoles.Count == 0)
            {
                SetMessage("Pilih minimal satu role.", isError: true);
                return;
            }
            if (string.IsNullOrEmpty(createForm.ActiveRole))
            {
                SetMessage("Pilih role aktif.", isError: true);
                return;
            }

            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            await UserAdmin.CreateUserAsync(
                state.User,
                createForm.Email.Trim(),
                createForm.Password,
                createForm.SelectedRoles.ToArray(),
                createForm.ActiveRole);

            SetMessage($"User {createForm.Email.Trim()} berhasil dibuat.");
            CloseCreateModal();
            await ReloadAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            SetMessage(ex.Message, isError: true);
        }
        catch (InvalidOperationException ex)
        {
            SetMessage(ex.Message, isError: true);
        }
        finally
        {
            isCreating = false;
        }
    }

    private sealed class CreateUserForm
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
        public List<string> SelectedRoles { get; set; } = new();
        public string ActiveRole { get; set; } = "";
    }
}