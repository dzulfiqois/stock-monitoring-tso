@page "/tso/create"
@page "/tso/{Id:int}/edit"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using StockMonitorTso.Domain.Entities
@using StockMonitorTso.Infrastructure.Services

@inject ITransportOrderService TsoService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(IsEdit ? "Update TSO" : "Buat TSO — Wizard")</PageTitle>

<div class="sm-breadcrumb" style="margin-bottom:12px">
    <a href="tso">Transport Shipping Order</a>
    <span class="material-symbols-outlined" style="font-size:16px">chevron_right</span>
    <span style="color:var(--sm-on-surface)">@(IsEdit ? "Update" : "Buat Baru")</span>
</div>

<div style="display:flex;gap:8px;align-items:center;margin-bottom:16px">
    @for (int i = 1; i <= 4; i++)
    {
        var active = step == i;
        var done = step > i;
        <div style="display:flex;align-items:center;gap:8px">
            <div style="width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;background:@(active ? "var(--sm-primary)" : done ? "var(--sm-success)" : "var(--sm-surface-container-high)");color:@(active || done ? "white" : "var(--sm-on-surface-variant)")">@(done ? "✓" : i.ToString())</div>
            <span class="sm-label-caps" style="color:@(active ? "var(--sm-primary)" : "var(--sm-on-surface-variant)")">@StepLabel(i)</span>
        </div>
        @if (i < 4)
        {
            <div style="flex:1;height:2px;background:var(--sm-outline-variant);margin:0 4px"></div>
        }
    }
</div>

<div class="sm-card" style="padding:16px">
    @if (step == 1)
    {
        <h3 class="sm-title-sm">1. Lokasi Gudang & Obyek</h3>
        <div style="margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div>
                <label class="sm-label-caps" style="display:block;margin-bottom:6px">Gudang Wilayah Tujuan</label>
                <select class="sm-filter" style="width:100%" @bind="wilayahTujuan">
                    @foreach (var w in WilayahInfo.All)
                    {
                        <option value="@w">@w.DisplayName()</option>
                    }
                </select>
            </div>
            <div>
                <label class="sm-label-caps" style="display:block;margin-bottom:6px">Tipe Muatan</label>
                <div style="display:flex;gap:12px;margin-top:6px">
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer"><input type="radio" name="muatan" checked="@isMinyak" @onchange="() => isMinyak = true" /> Minyak Tanah</label>
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer"><input type="radio" name="muatan" checked="@(!isMinyak)" @onchange="() => isMinyak = false" /> Gas LPG</label>
                </div>
            </div>
        </div>
        @if (isMinyak)
        {
            <div style="margin-top:12px">
                <label class="sm-label-caps" style="display:block;margin-bottom:6px">Kuantitas Minyak Tanah (Kiloliter)</label>
                <div style="display:flex;align-items:center;gap:8px">
                    <button type="button" class="sm-btn sm-btn-outline sm-btn-sm" @onclick="() => qtyMinyak = Math.Max(1, qtyMinyak - 1)">−</button>
                    <input type="number" min="1" step="0.1" @bind="qtyMinyak" style="width:120px;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                    <button type="button" class="sm-btn sm-btn-outline sm-btn-sm" @onclick="() => qtyMinyak++">+</button>
                    <span class="sm-body-md">Kiloliter</span>
                </div>
            </div>
        }
        else
        {
            <div style="margin-top:12px;display:flex;flex-direction:column;gap:10px">
                <div class="sm-label-caps">Gas LPG — per jenis tabung (1 trip bisa multi-jenis)</div>
                <div style="display:grid;grid-template-columns:120px 1fr;gap:10px;align-items:center">
                    <span class="sm-body-md"><span class="sm-chip chip-55"><span class="dot"></span>5.5 kg</span></span>
                    <div style="display:flex;align-items:center;gap:8px">
                        <button type="button" class="sm-btn sm-btn-outline sm-btn-sm" @onclick="() => qty55 = Math.Max(0, qty55 - 1)">−</button>
                        <input type="number" min="0" step="1" @bind="qty55" style="width:100px;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                        <button type="button" class="sm-btn sm-btn-outline sm-btn-sm" @onclick="() => qty55++">+</button>
                        <span class="sm-body-md">Tabung</span>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:120px 1fr;gap:10px;align-items:center">
                    <span class="sm-body-md"><span class="sm-chip chip-12"><span class="dot"></span>12 kg</span></span>
                    <div style="display:flex;align-items:center;gap:8px">
                        <button type="button" class="sm-btn sm-btn-outline sm-btn-sm" @onclick="() => qty12 = Math.Max(0, qty12 - 1)">−</button>
                        <input type="number" min="0" step="1" @bind="qty12" style="width:100px;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                        <button type="button" class="sm-btn sm-btn-outline sm-btn-sm" @onclick="() => qty12++">+</button>
                        <span class="sm-body-md">Tabung</span>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:120px 1fr;gap:10px;align-items:center">
                    <span class="sm-body-md"><span class="sm-chip chip-50"><span class="dot"></span>50 kg</span></span>
                    <div style="display:flex;align-items:center;gap:8px">
                        <button type="button" class="sm-btn sm-btn-outline sm-btn-sm" @onclick="() => qty50 = Math.Max(0, qty50 - 1)">−</button>
                        <input type="number" min="0" step="1" @bind="qty50" style="width:100px;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                        <button type="button" class="sm-btn sm-btn-outline sm-btn-sm" @onclick="() => qty50++">+</button>
                        <span class="sm-body-md">Tabung</span>
                    </div>
                </div>
            </div>
        }
    }
    else if (step == 2)
    {
        <h3 class="sm-title-sm">2. Rute & Jadwal</h3>
        <div style="margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div>
                <label class="sm-label-caps" style="display:block;margin-bottom:6px">Rute Asal</label>
                <input type="text" class="sm-frame" @bind="ruteAsal" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
            </div>
            <div>
                <label class="sm-label-caps" style="display:block;margin-bottom:6px">Rute Tujuan</label>
                <input type="text" class="sm-frame" @bind="ruteTujuan" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
            </div>
            <div>
                <label class="sm-label-caps" style="display:block;margin-bottom:6px">Jarak (km) — manual, wajib jika tarif per_kilometer</label>
                <input type="number" min="0" step="0.1" @bind="jarakKm" placeholder="Kosongkan jika per_tabung/per_kiloliter" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
            </div>
            <div>
                <label class="sm-label-caps" style="display:block;margin-bottom:6px">Tanggal Keberangkatan</label>
                <input type="date" class="sm-frame" @bind="tanggalBerangkat" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
            </div>
            <div>
                <label class="sm-label-caps" style="display:block;margin-bottom:6px">ETA (otomatis +7 hari)</label>
                <input type="text" class="sm-frame" value="@tanggalBerangkat.AddDays(7).ToString("dd MMM yyyy")" disabled style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-container)" />
            </div>
        </div>
    }
    else if (step == 3)
    {
        <h3 class="sm-title-sm">3. Transporter</h3>
        <div style="margin-top:12px">
            <label class="sm-label-caps" style="display:block;margin-bottom:6px">Mitra Transporter</label>
            <select class="sm-filter" style="width:100%" @bind="selectedMitraId" @bind:after="OnMitraChanged">
                <option value="">— Pilih Mitra —</option>
                @foreach (var m in filteredMitra)
                {
                    <option value="@m.Id">@m.Nama — @m.JenisKendaraan (Kapasitas @m.KapasitasMax @m.SatuanKapasitas)</option>
                }
            </select>
        </div>
        @if (selectedMitra is not null)
        {
            <div class="sm-card" style="margin-top:12px;padding:12px;background:var(--sm-surface-container-low)">
                <div class="sm-label-caps">Mitra: @selectedMitra.Nama (@selectedMitra.JenisKendaraan)</div>
                <div class="sm-body-md" style="font-size:12px;color:var(--sm-on-surface-variant)">Area: @string.Join(", ", selectedMitra.AreaCoverage) | Tarif per-jenis:</div>
                @foreach (var t in selectedMitra.Tarifs)
                {
                    <div class="sm-body-md" style="font-size:12px">@t.Produk.DisplayName(): Rp @t.Tarif.ToString("N0") / @t.SatuanTarif</div>
                }
                <div class="sm-label-caps" style="margin-top:8px">Estimasi Biaya Total</div>
                <div class="sm-title-sm" style="color:var(--sm-primary)">Rp @estimasiBiaya.ToString("N0")</div>
                <div class="sm-body-md" style="font-size:12px;color:var(--sm-on-surface-variant)">@estimasiDetail</div>
            </div>
        }
    }
    else if (step == 4)
    {
        <h3 class="sm-title-sm">4. Ringkasan Proposal</h3>
        <div style="margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="sm-card" style="padding:12px"><span class="sm-label-caps">Gudang Tujuan</span><div class="sm-title-sm">@wilayahTujuan.DisplayName()</div><span class="sm-label-caps">Rute</span><div class="sm-body-md">@ruteAsal → @ruteTujuan @(jarakKm.HasValue ? $"({jarakKm} km)" : "")</div></div>
            <div class="sm-card" style="padding:12px"><span class="sm-label-caps">Obyek</span><div class="sm-body-md">@ringkasanObyek</div><span class="sm-label-caps">Jadwal</span><div class="sm-body-md">@tanggalBerangkat.ToString("dd MMM yyyy") → ETA @tanggalBerangkat.AddDays(7).ToString("dd MMM yyyy")</div></div>
            <div class="sm-card" style="padding:12px"><span class="sm-label-caps">Transporter</span><div class="sm-title-sm">@(selectedMitra?.Nama ?? "-") (@(selectedMitra?.JenisKendaraan ?? "-"))</div><span class="sm-label-caps">Estimasi Biaya</span><div class="sm-title-sm">Rp @estimasiBiaya.ToString("N0")</div></div>
            <div class="sm-card" style="padding:12px;background:var(--sm-surface-container-low)"><span class="sm-label-caps">Draft Proposal</span><div class="sm-body-md">Order No: @(IsEdit ? existingOrder?.OrderNo ?? "-" : "akan digenerate saat Submit")</div><div class="sm-body-md">Vol Total: @totalKuantitas.ToString("0.##") @(isMinyak ? "Kiloliter" : "Tabung")</div></div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="margin-top:12px;padding:10px;border-radius:var(--sm-radius);background:var(--sm-error-container);color:var(--sm-on-error-container)">@errorMessage</div>
    }

    <div style="display:flex;justify-content:space-between;margin-top:16px">
        <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="Prev" disabled="@(step == 1)">Kembali</button>
        @if (step < 4)
        {
            <button class="sm-btn sm-btn-primary sm-btn-sm" @onclick="Next">Lanjutkan</button>
        }
        else
        {
            <button class="sm-btn sm-btn-primary" @onclick="Submit">
                <span class="material-symbols-outlined" style="font-size:18px">@(IsEdit ? "save" : "check")</span> @(IsEdit ? "Update" : "Submit & Preview")
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private bool IsEdit => Id.HasValue;
    private TransportOrder? existingOrder;
    private int step = 1;
    private Wilayah wilayahTujuan = Wilayah.Papua;
    private bool isMinyak = true;
    private decimal qtyMinyak = 100;
    private decimal qty55, qty12, qty50;
    private decimal? jarakKm;
    private string ruteAsal = "Pusat";
    private string ruteTujuan = "Gudang Wilayah Papua";
    private DateTime tanggalBerangkat = DateTime.Today.AddDays(1);
    private string? selectedMitraId;
    private MitraTso? selectedMitra;
    private decimal estimasiBiaya;
    private string estimasiDetail = "";
    private string? errorMessage;
    private List<MitraTso> allMitra = new();
    private List<MitraTso> filteredMitra => allMitra.Where(m => m.AreaCoverage.Contains(wilayahTujuan.DisplayName())).ToList();
    private string ringkasanObyek => isMinyak ? $"Minyak Tanah — {qtyMinyak} Kiloliter" : string.Join(", ", new[] { (qty55 > 0 ? $"5.5kg:{qty55}" : null), (qty12 > 0 ? $"12kg:{qty12}" : null), (qty50 > 0 ? $"50kg:{qty50}" : null) }.Where(s => s != null));
    private decimal totalKuantitas => isMinyak ? qtyMinyak : qty55 + qty12 + qty50;

    private string StepLabel(int i) => i switch { 1 => "Tujuan & Obyek", 2 => "Rute & Jadwal", 3 => "Transporter", 4 => "Ringkasan", _ => "" };

    protected override async Task OnInitializedAsync()
    {
        allMitra = (await TsoService.ListMitraAsync()).ToList();
        if (IsEdit && Id.HasValue)
        {
            existingOrder = await TsoService.GetAsync(Id.Value);
            if (existingOrder is not null)
            {
                wilayahTujuan = existingOrder.WilayahTujuan;
                jarakKm = existingOrder.JarakKm;
                ruteAsal = existingOrder.RuteAsal;
                ruteTujuan = existingOrder.RuteTujuan;
                tanggalBerangkat = existingOrder.TanggalKeberangkatan;
                selectedMitraId = existingOrder.MitraId;
                selectedMitra = allMitra.FirstOrDefault(m => m.Id == selectedMitraId);
                if (existingOrder.Details.Count > 0)
                {
                    isMinyak = existingOrder.Details.Any(d => d.Produk == Produk.MinyakTanah);
                    qtyMinyak = existingOrder.Details.FirstOrDefault(d => d.Produk == Produk.MinyakTanah)?.Kuantitas ?? 0;
                    qty55 = existingOrder.Details.FirstOrDefault(d => d.Produk == Produk.Lpg5_5Kg)?.Kuantitas ?? 0;
                    qty12 = existingOrder.Details.FirstOrDefault(d => d.Produk == Produk.Lpg12Kg)?.Kuantitas ?? 0;
                    qty50 = existingOrder.Details.FirstOrDefault(d => d.Produk == Produk.Lpg50Kg)?.Kuantitas ?? 0;
                    if (!isMinyak && qtyMinyak > 0) isMinyak = false;
                }
                else
                {
                    isMinyak = existingOrder.Produk == Produk.MinyakTanah;
                    if (isMinyak) qtyMinyak = existingOrder.Kuantitas;
                    else
                    {
                        if (existingOrder.Produk == Produk.Lpg5_5Kg) qty55 = existingOrder.Kuantitas;
                        else if (existingOrder.Produk == Produk.Lpg12Kg) qty12 = existingOrder.Kuantitas;
                        else if (existingOrder.Produk == Produk.Lpg50Kg) qty50 = existingOrder.Kuantitas;
                    }
                }
                UpdateEstimasi();
            }
        }
        else
        {
            ruteTujuan = $"Gudang Wilayah {wilayahTujuan.DisplayName()}";
        }
    }

    private void OnMitraChanged()
    {
        selectedMitra = allMitra.FirstOrDefault(m => m.Id == selectedMitraId);
        UpdateEstimasi();
    }

    private void UpdateEstimasi()
    {
        if (selectedMitra is null)
        {
            estimasiBiaya = 0; estimasiDetail = "";
            return;
        }
        decimal total = 0;
        var parts = new List<string>();
        void Add(Produk p, decimal qty)
        {
            if (qty <= 0) return;
            var tarifRow = selectedMitra.Tarifs.FirstOrDefault(t => t.Produk == p);
            var tarif = tarifRow?.Tarif ?? selectedMitra.Tarif;
            var satuan = tarifRow?.SatuanTarif ?? selectedMitra.SatuanTarif;
            var est = satuan.Contains("kilometer", StringComparison.OrdinalIgnoreCase) && jarakKm.HasValue ? tarif * qty * jarakKm.Value : tarif * qty;
            total += est;
            parts.Add($"{p.DisplayName()} {qty} × {tarif:N0} = {est:N0}");
        }
        if (isMinyak) Add(Produk.MinyakTanah, qtyMinyak);
        else { Add(Produk.Lpg5_5Kg, qty55); Add(Produk.Lpg12Kg, qty12); Add(Produk.Lpg50Kg, qty50); }
        estimasiBiaya = total;
        estimasiDetail = string.Join(" + ", parts);
    }

    private void Next()
    {
        errorMessage = null;
        if (step == 1)
        {
            if (isMinyak && qtyMinyak <= 0) { errorMessage = "Kuantitas Minyak harus > 0."; return; }
            if (!isMinyak && qty55 <= 0 && qty12 <= 0 && qty50 <= 0) { errorMessage = "Pilih minimal 1 jenis tabung dengan kuantitas > 0."; return; }
            ruteTujuan = $"Gudang Wilayah {wilayahTujuan.DisplayName()}";
        }
        if (step == 2)
        {
            if (tanggalBerangkat.Date < DateTime.Today) { errorMessage = "Tanggal Keberangkatan tidak boleh lampau."; return; }
            if (jarakKm.HasValue && jarakKm <= 0) { errorMessage = "Jarak harus > 0 atau kosongkan."; return; }
        }
        if (step == 3)
        {
            if (string.IsNullOrEmpty(selectedMitraId)) { errorMessage = "Pilih Mitra transporter."; return; }
            UpdateEstimasi();
        }
        if (step < 4) step++;
    }

    private void Prev()
    {
        errorMessage = null;
        if (step > 1) step--;
    }

    private async Task Submit()
    {
        errorMessage = null;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var details = new List<TransportOrderDetailDto>();
        if (isMinyak)
        {
            if (qtyMinyak > 0) details.Add(new TransportOrderDetailDto { Produk = Produk.MinyakTanah, Kuantitas = qtyMinyak });
        }
        else
        {
            if (qty55 > 0) details.Add(new TransportOrderDetailDto { Produk = Produk.Lpg5_5Kg, Kuantitas = qty55 });
            if (qty12 > 0) details.Add(new TransportOrderDetailDto { Produk = Produk.Lpg12Kg, Kuantitas = qty12 });
            if (qty50 > 0) details.Add(new TransportOrderDetailDto { Produk = Produk.Lpg50Kg, Kuantitas = qty50 });
        }
        if (details.Count == 0) { errorMessage = "Kuantitas tidak boleh kosong."; return; }
        try
        {
            if (IsEdit && Id.HasValue)
            {
                var req = new UpdateTransportOrderRequest
                {
                    MitraId = selectedMitraId!,
                    WilayahTujuan = wilayahTujuan,
                    Produk = details[0].Produk,
                    Kuantitas = details.Sum(d => d.Kuantitas),
                    TanggalKeberangkatan = tanggalBerangkat,
                    RuteAsal = ruteAsal,
                    RuteTujuan = ruteTujuan,
                    JarakKm = jarakKm,
                    Details = details,
                    RowVersion = existingOrder!.RowVersion,
                };
                var updated = await TsoService.UpdateAsync(state.User, Id.Value, req);
                NavigationManager.NavigateTo($"tso/{updated.Id}");
            }
            else
            {
                var req = new CreateTransportOrderRequest
                {
                    MitraId = selectedMitraId!,
                    WilayahTujuan = wilayahTujuan,
                    Produk = details[0].Produk,
                    Kuantitas = details.Sum(d => d.Kuantitas),
                    TanggalKeberangkatan = tanggalBerangkat,
                    RuteAsal = ruteAsal,
                    RuteTujuan = ruteTujuan,
                    JarakKm = jarakKm,
                    Details = details,
                };
                var order = await TsoService.CreateAsync(state.User, req);
                NavigationManager.NavigateTo($"tso/{order.Id}");
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }
}
