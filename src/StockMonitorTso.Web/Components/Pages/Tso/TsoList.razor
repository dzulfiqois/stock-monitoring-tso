@page "/tso"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using StockMonitorTso.Domain.Entities
@using StockMonitorTso.Infrastructure.Services

@inject ITransportOrderService TsoService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Transport Shipping Order</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <div>
        <h1 class="sm-display-lg">Transport Shipping Order</h1>
        <p class="sm-body-md" style="max-width:660px;margin:4px 0 0">Daftar order pengiriman Pusat → Gudang Wilayah.</p>
    </div>
    <AuthorizeView Roles="Superadmin,Operator">
        <Authorized>
            <a class="sm-btn sm-btn-primary" href="tso/create">
                <span class="material-symbols-outlined" style="font-size:18px">add</span> Buat TSO
            </a>
        </Authorized>
    </AuthorizeView>
</div>

@if (orders is null)
{
    <div class="sm-body-md" style="padding:40px 0">Memuat...</div>
}
else if (orders.Count == 0)
{
    <div class="sm-card" style="padding:24px;text-align:center">
        <span class="material-symbols-outlined" style="font-size:40px;color:var(--sm-outline)">local_shipping</span>
        <div class="sm-body-md" style="margin-top:8px">Belum ada order TSO.</div>
    </div>
}
else
{
    <div class="sm-table-wrap">
        <div style="overflow-x:auto">
            <table class="sm-table">
                <thead>
                    <tr>
                        <th>Order No</th>
                        <th>Mitra</th>
                        <th>Tujuan</th>
                        <th>Material</th>
                        <th class="num">Kuantitas</th>
                        <th>Keberangkatan</th>
                        <th>Status</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in orders)
                    {
                        <tr>
                            <td style="font-weight:600">@o.OrderNo</td>
                            <td>@o.MitraNamaSnapshot</td>
                            <td>@o.WilayahTujuan.DisplayName()</td>
                            <td>@o.Produk.DisplayName()</td>
                            <td class="num">@o.Kuantitas.ToString("0.##") @o.Satuan</td>
                            <td>@o.TanggalKeberangkatan.ToString("dd MMM yyyy")</td>
                            <td><span class="sm-pill sm-pill-neutral">@o.Status</span></td>
                            <td>
                                <div style="display:flex;gap:8px">
                                    <a class="sm-btn sm-btn-outline sm-btn-sm" href="tso/@o.Id">Preview</a>
                                    <AuthorizeView Roles="Superadmin,Supervisi">
                                        <Authorized>
                                            <a class="sm-btn sm-btn-outline sm-btn-sm" href="tso/@o.Id/edit">Update</a>
                                        </Authorized>
                                    </AuthorizeView>
                                    <AuthorizeView Roles="Superadmin">
                                        <Authorized>
                                            <button class="sm-btn sm-btn-danger sm-btn-sm" @onclick="() => PromptDelete(o)"><span class="material-symbols-outlined" style="font-size:16px">delete</span></button>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (deleteTarget is not null)
{
    <div class="sm-modal-backdrop"></div>
    <div style="position:fixed;inset:0;z-index:110;display:flex;align-items:center;justify-content:center">
        <div class="sm-modal">
            <div class="sm-modal-header">
                <h3 class="sm-title-sm" style="margin:0">Hapus Order</h3>
                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="CancelDelete"><span class="material-symbols-outlined" style="font-size:18px">close</span></button>
            </div>
            <div class="sm-modal-body">
                <p class="sm-body-md" style="margin:0">Hapus order <strong>@deleteTarget.OrderNo</strong> — @deleteTarget.MitraNamaSnapshot → @deleteTarget.WilayahTujuan.DisplayName()?</p>
            </div>
            <div class="sm-modal-footer">
                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="CancelDelete">Batal</button>
                <button class="sm-btn sm-btn-danger sm-btn-sm" @onclick="ConfirmDelete">Hapus</button>
            </div>
        </div>
    </div>
}

@code {
    private List<TransportOrder>? orders;
    private TransportOrder? deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        orders = (await TsoService.ListAsync()).ToList();
    }

    private void PromptDelete(TransportOrder o) => deleteTarget = o;
    private void CancelDelete() => deleteTarget = null;
    private async Task ConfirmDelete()
    {
        var target = deleteTarget; deleteTarget = null;
        if (target is null) return;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        await TsoService.DeleteAsync(state.User, target.Id);
        orders = (await TsoService.ListAsync()).ToList();
    }
}
