@page "/agen/{AgenId:int}/outlet"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using StockMonitorTso.Domain.Entities
@using StockMonitorTso.Infrastructure.Services

@inject IStockDashboardService Dashboard
@inject IOutletService OutletService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Daftar Outlet</PageTitle>

@if (agenDetail is null)
{
    <div class="sm-card" style="padding:24px">Agen tidak ditemukan.</div>
}
else
{
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px">
        <div>
            <div class="sm-breadcrumb">
                <a href="gudang-wilayah">Gudang Wilayah</a>
                <span class="material-symbols-outlined" style="font-size:16px">chevron_right</span>
                <a href="wilayah/@agenDetail.Wilayah/agen">Agen @agenDetail.Wilayah.DisplayName()</a>
                <span class="material-symbols-outlined" style="font-size:16px">chevron_right</span>
                <a href="agen/@AgenId">@agenDetail.Nama</a>
                <span class="material-symbols-outlined" style="font-size:16px">chevron_right</span>
                <span style="color:var(--sm-on-surface)">Outlet</span>
            </div>
            <h1 class="sm-headline-md" style="margin-top:6px">Daftar Outlet — @agenDetail.Nama</h1>
            <p class="sm-body-md" style="margin:4px 0 0">Outlet milik Agen @agenDetail.Nama (@agenDetail.Wilayah.DisplayName()).</p>
        </div>
        <AuthorizeView Roles="Superadmin,Supervisi">
            <Authorized>
                <button class="sm-btn sm-btn-primary sm-btn-sm" @onclick="OpenCreateModal">
                    <span class="material-symbols-outlined" style="font-size:18px">add</span> Tambah Outlet
                </button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (rows is null)
    {
        <div class="sm-body-md" style="padding:40px 0">Memuat...</div>
    }
    else if (rows.Count == 0)
    {
        <div class="sm-card" style="padding:24px;text-align:center">
            <span class="material-symbols-outlined" style="font-size:40px;color:var(--sm-outline)">store</span>
            <div class="sm-body-md" style="margin-top:8px">Belum ada outlet. Gunakan "Tambah Outlet".</div>
        </div>
    }
    else
    {
        <div class="sm-table-wrap">
            <div style="overflow-x:auto">
                <table class="sm-table">
                    <thead>
                        <tr>
                            <th>Nama Outlet</th>
                            <th>Tanggal Daftar</th>
                            <th class="num">Total Stok</th>
                            <th class="num">Produk</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td style="font-weight:600">@row.Nama</td>
                                <td>@row.TanggalDaftar.ToString("dd MMM yyyy")</td>
                                <td class="num">@row.TotalStok.ToString("N0")</td>
                                <td class="num">@row.JumlahProduk</td>
                                <td>@StatusPill(row.StatusTerburuk)</td>
                                <td>
                                    <div style="display:flex;gap:8px">
                                        <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="() => NavigateDetail(row.OutletId)">Detail</button>
                                        <AuthorizeView Roles="Superadmin,Supervisi">
                                            <Authorized>
                                                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="() => OpenEditModal(row)">Edit</button>
                                            </Authorized>
                                        </AuthorizeView>
                                        <AuthorizeView Roles="Superadmin">
                                            <Authorized>
                                                <button class="sm-btn sm-btn-danger sm-btn-sm" @onclick="() => PromptDelete(row)"><span class="material-symbols-outlined" style="font-size:16px">delete</span></button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (showFormModal)
{
    <div class="sm-modal-backdrop"></div>
    <div style="position:fixed;inset:0;z-index:110;display:flex;align-items:center;justify-content:center">
        <div class="sm-modal">
            <div class="sm-modal-header">
                <h3 class="sm-title-sm" style="margin:0">@(editingId is null ? "Tambah Outlet" : "Edit Outlet")</h3>
                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="CloseFormModal"><span class="material-symbols-outlined" style="font-size:18px">close</span></button>
            </div>
            <div class="sm-modal-body">
                <div style="margin-bottom:12px">
                    <label class="sm-label-caps" style="display:block;margin-bottom:6px">Nama Outlet</label>
                    <input type="text" class="sm-frame" @bind="namaOutlet" style="width:100%;padding:10px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                </div>
                <div style="margin-bottom:12px">
                    <label class="sm-label-caps" style="display:block;margin-bottom:6px">Keterangan</label>
                    <input type="text" class="sm-frame" @bind="keteranganOutlet" style="width:100%;padding:10px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                </div>
                @if (!string.IsNullOrEmpty(formMessage))
                {
                    <div style="margin:12px 0 0;padding:10px;border-radius:var(--sm-radius);background:var(--sm-error-container);color:var(--sm-on-error-container)">@formMessage</div>
                }
            </div>
            <div class="sm-modal-footer">
                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="CloseFormModal">Batal</button>
                <button class="sm-btn sm-btn-primary sm-btn-sm" @onclick="SaveForm">Simpan</button>
            </div>
        </div>
    </div>
}

@if (deleteTarget is not null)
{
    <div class="sm-modal-backdrop"></div>
    <div style="position:fixed;inset:0;z-index:110;display:flex;align-items:center;justify-content:center">
        <div class="sm-modal">
            <div class="sm-modal-header">
                <h3 class="sm-title-sm" style="margin:0">Hapus Outlet</h3>
                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="CancelDelete"><span class="material-symbols-outlined" style="font-size:18px">close</span></button>
            </div>
            <div class="sm-modal-body">
                <p class="sm-body-md" style="margin:0">Hapus <strong style="color:var(--sm-on-surface)">@deleteTarget.Nama</strong>? Outlet dihapus (soft delete) beserta baris stoknya.</p>
            </div>
            <div class="sm-modal-footer">
                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="CancelDelete">Batal</button>
                <button class="sm-btn sm-btn-danger sm-btn-sm" @onclick="ConfirmDelete">Hapus</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int AgenId { get; set; }

    private AgenDetail? agenDetail;
    private List<OutletInventarisRow>? rows;
    private bool showFormModal;
    private int? editingId;
    private string namaOutlet = "";
    private string? keteranganOutlet;
    private string? formMessage;
    private OutletInventarisRow? deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        agenDetail = await Dashboard.GetAgenDetailAsync(AgenId);
        if (agenDetail is not null)
        {
            rows = (await Dashboard.GetOutletInventarisAsync(AgenId)).ToList();
        }
    }

    private void NavigateDetail(int outletId) => NavigationManager.NavigateTo($"outlet/{outletId}");

    private void OpenCreateModal()
    {
        editingId = null; namaOutlet = ""; keteranganOutlet = null; formMessage = null; showFormModal = true;
    }

    private void OpenEditModal(OutletInventarisRow row)
    {
        editingId = row.OutletId; namaOutlet = row.Nama; keteranganOutlet = null; formMessage = null; showFormModal = true;
    }

    private void CloseFormModal() { showFormModal = false; formMessage = null; }

    private async Task SaveForm()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        try
        {
            if (editingId is null)
            {
                await OutletService.CreateAsync(state.User, new CreateOutletRequest { Nama = namaOutlet, AgenId = AgenId, Keterangan = keteranganOutlet });
            }
            else
            {
                await OutletService.UpdateAsync(state.User, editingId.Value, new UpdateOutletRequest { Nama = namaOutlet, Keterangan = keteranganOutlet });
            }
            CloseFormModal(); await LoadAsync();
        }
        catch (Exception ex) { formMessage = ex.Message; }
    }

    private void PromptDelete(OutletInventarisRow row) => deleteTarget = row;
    private void CancelDelete() => deleteTarget = null;
    private async Task ConfirmDelete()
    {
        var target = deleteTarget; deleteTarget = null;
        if (target is null) return;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        try { await OutletService.DeleteAsync(state.User, target.OutletId); } catch (Exception ex) { formMessage = ex.Message; showFormModal = true; }
        await LoadAsync();
    }

    private static MarkupString StatusPill(Status? status)
    {
        var (label, css) = status switch
        {
            Status.Aman => ("Aman", "sm-pill sm-pill-success"),
            Status.Warning => ("Warning", "sm-pill sm-pill-warning"),
            Status.Kritis => ("Kritis", "sm-pill sm-pill-danger"),
            _ => ("-", "sm-pill sm-pill-neutral"),
        };
        return new MarkupString($"<span class=\"{css}\">{label}</span>");
    }
}
