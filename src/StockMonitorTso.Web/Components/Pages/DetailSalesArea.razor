@page "/sales-area/{Wilayah}/{Produk}"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using StockMonitorTso.Domain.Entities
@using StockMonitorTso.Infrastructure.Services

@inject IStockDashboardService Dashboard
@inject IStockWriteService StockWrite
@inject IAgenService Agen
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Detail Sales Area</PageTitle>

@if (detail is null)
{
    <div class="sm-card" style="padding:24px">Data tidak ditemukan.</div>
}
else
{
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px">
        <div>
            <div class="sm-breadcrumb">
                <a href="gudang-wilayah">Gudang Wilayah</a>
                <span class="material-symbols-outlined" style="font-size:16px">chevron_right</span>
                <span style="color:var(--sm-on-surface)">@WilayahDisplay (@ProdukDisplay)</span>
            </div>
            <h1 class="sm-headline-md" style="margin-top:6px">Detail Monitoring @ProdukDisplay</h1>
            <p class="sm-body-md" style="margin:4px 0 0">Sales Area @WilayahDisplay — Realisasi dan pemantauan stok harian.</p>
        </div>
        <AuthorizeView Roles="Superadmin,Supervisi">
            <Authorized>
                <div style="display:flex;gap:10px;align-items:center">
                    <button class="sm-btn sm-btn-outline" @onclick="OpenTransferModal">
                        <span class="material-symbols-outlined" style="font-size:18px">local_shipping</span> Kirim ke Agen
                    </button>
                    <button class="sm-btn sm-btn-primary" @onclick="OpenUpdateModal">
                        <span class="material-symbols-outlined" style="font-size:18px">sync</span> Update Data Harian
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:20px">
        @if (IsGas)
        {
            <div class="sm-kpi">
                <span class="sm-label-caps">Total Sisa Stok</span>
                <div><span class="value">@detail.TotalStok.ToString("N0")</span> <span class="unit">@Satuan</span></div>
            </div>
            <div class="sm-kpi">
                <span class="sm-label-caps">Daily Obj. Throughput</span>
                <div><span class="value" style="font-size:26px">@detail.Rows.Sum(r => r.DOT).ToString("0.#")</span> <span class="unit">@Satuan/hari</span></div>
            </div>
            <div class="sm-kpi">
                <span class="sm-label-caps">Covered Days Estimasi</span>
                <div><span class="value" style="font-size:26px">@(detail.CdTerburuk?.ToString("0.##") ?? "-")</span> <span class="unit">hari</span></div>
            </div>
            <div class="sm-kpi @(detail.StatusArea == Status.Kritis ? "sm-kpi-kritis" : "")">
                <span class="sm-label-caps">Status Area</span>
                <div><span class="value" style="font-size:26px">@StatusText(detail.StatusArea)</span></div>
            </div>
        }
        else
        {
            <div class="sm-kpi">
                <span class="sm-label-caps">Total Sisa Stok</span>
                <div><span class="value">@detail.TotalStok.ToString("N0")</span> <span class="unit">@Satuan</span></div>
            </div>
            <div class="sm-kpi">
                <span class="sm-label-caps">Terjual</span>
                <div><span class="value" style="font-size:26px">@FormatKl(detail.Rows.Sum(r => r.StokHabisTerjual ?? 0))</span> <span class="unit">@Satuan</span></div>
            </div>
            <div class="sm-kpi">
                <span class="sm-label-caps">Intransit</span>
                <div><span class="value" style="font-size:26px">@FormatKl(detail.Rows.Sum(r => r.StokIntransit ?? 0))</span> <span class="unit">@Satuan</span></div>
            </div>
            <div class="sm-kpi @(detail.StatusArea == Status.Kritis ? "sm-kpi-kritis" : "")">
                <span class="sm-label-caps">Status Area</span>
                <div><span class="value" style="font-size:26px">@StatusText(detail.StatusArea)</span></div>
            </div>
        }
    </div>

    <div class="sm-table-wrap" style="margin-bottom:20px">
        <div class="sm-label-caps" style="padding:14px var(--sm-pad);border-bottom:1px solid var(--sm-outline-variant);display:flex;justify-content:space-between;align-items:center">
            <span>Data Inventory per Tier</span>
            <span style="text-transform:none;letter-spacing:0">Realisasi: @(detail.Rows.Count > 0 ? detail.Rows[0].ExhaustDate?.ToString("dd MMM yyyy") : "-")</span>
        </div>
        <div style="overflow-x:auto">
            <table class="sm-table">
                <thead>
                    <tr>
                        <th>Tier</th>
                        <th>Produk</th>
                        <th class="num">Stok</th>
                        <th class="num">DOT</th>
                        <th class="num">Covered Days</th>
                        <th>Status</th>
                        <th>Exhaust</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in detail.Rows)
                    {
                        <tr>
                            <td>@row.Tier.DisplayName()</td>
                            <td>@row.Produk.DisplayName()</td>
                            <td class="num">@row.Stok.ToString("N0")</td>
                            <td class="num">@row.DOT.ToString("0.##")</td>
                            <td class="num">@(row.Cd?.ToString("0.##") ?? "N/A")</td>
                            <td>@StatusPill(row.Status)</td>
                            <td>@row.ExhaustDate?.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="sm-table-wrap">
        <div class="sm-label-caps" style="padding:14px var(--sm-pad);border-bottom:1px solid var(--sm-outline-variant)">
            Log Transaksi Stok
        </div>
        <div style="overflow-x:auto">
            <table class="sm-table">
                <thead>
                    <tr>
                        <th>Tanggal</th>
                        <th>Jenis</th>
                        <th class="num">Kuantitas</th>
                        <th>Tujuan</th>
                        <th>Catatan</th>
                        <th class="num">Stok Sesudah</th>
                    </tr>
                </thead>
                <tbody>
                    @if (detail.Transactions.Count == 0)
                    {
                        <tr><td colspan="6" style="text-align:center;color:var(--sm-on-surface-variant)">Belum ada transaksi.</td></tr>
                    }
                    else
                    {
                        @foreach (var t in detail.Transactions)
                        {
                            <tr>
                                <td>@t.Tanggal.ToString("dd MMM yyyy")</td>
                                <td>@t.Type</td>
                                <td class="num">@t.Kuantitas.ToString("0.###")</td>
                                <td>@(t.Tujuan ?? "-")</td>
                                <td>@(t.Catatan ?? "-")</td>
                                <td class="num">@t.StokSesudah.ToString("0.###")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (showUpdateModal)
{
    <div class="sm-modal-backdrop"></div>
    <div style="position:fixed;inset:0;z-index:110;display:flex;align-items:center;justify-content:center">
        <div class="sm-modal">
            <div class="sm-modal-header">
                <h3 class="sm-title-sm" style="margin:0">Update Data Harian</h3>
                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="CloseUpdateModal">
                    <span class="material-symbols-outlined" style="font-size:18px">close</span>
                </button>
            </div>
            <div class="sm-modal-body">
                <div class="sm-segmented" style="margin-bottom:16px">
                    <button type="button" class="@(updateMode == "restock" ? "active" : "")" @onclick="SetModeRestock">Isi Ulang Stok</button>
                    <button type="button" class="@(updateMode == "daily" ? "active" : "")" @onclick="SetModeDaily">Update Stok Harian</button>
                </div>

                @if (updateMode == "restock")
                {
                    <div style="margin-bottom:12px">
                        <label class="sm-label-caps" style="display:block;margin-bottom:6px">Tier tujuan</label>
                        <select class="sm-filter" style="width:100%" @bind="selectedEntityIndex">
                            @for (var i = 0; i < detail!.Rows.Count; i++)
                            {
                                <option value="@i">@detail.Rows[i].Tier.DisplayName() (@detail.Rows[i].Produk.DisplayName())</option>
                            }
                        </select>
                    </div>
                }

                @if (updateMode == "restock")
                {
                    <div style="margin-bottom:12px">
                        <label class="sm-label-caps" style="display:block;margin-bottom:6px">Kuantitas tambah (isi ulang)</label>
                        <input type="number" class="sm-frame" @bind="restockQty" min="0" step="1" style="width:100%;padding:10px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                    </div>
                    <div style="margin-bottom:12px">
                        <label class="sm-label-caps" style="display:block;margin-bottom:6px">Tanggal Realisasi</label>
                        <input type="date" class="sm-frame" @bind="restockDate" style="width:100%;padding:10px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                    </div>
                }
                else
                {
                    <div style="margin-bottom:12px">
                        <label class="sm-label-caps" style="display:block;margin-bottom:6px">Tier tujuan</label>
                        <select class="sm-filter" style="width:100%" @bind="dailyTier">
                            @foreach (var tier in detail!.Rows.Select(r => r.Tier).Distinct())
                            {
                                <option value="@tier">@tier.DisplayName()</option>
                            }
                        </select>
                    </div>

                    @if (IsGas)
                    {
                        <div class="sm-label-caps" style="margin-bottom:8px">Per ukuran tabung</div>
                        <div style="display:flex;flex-direction:column;gap:14px">
                            <div style="border:1px solid var(--sm-outline-variant);border-radius:var(--sm-radius);padding:10px">
                                <div class="sm-label-caps" style="margin-bottom:8px"><span class="sm-chip chip-55"><span class="dot"></span>5.5 kg</span></div>
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                                    <div><label class="sm-label-caps" style="display:block;margin-bottom:4px">Stok Terjual (Tabung)</label><input type="number" class="sm-frame" @bind="dailyTerjual55" min="0" step="1" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" /></div>
                                    <div><label class="sm-label-caps" style="display:block;margin-bottom:4px">Stok Intransit</label><input type="number" class="sm-frame" @bind="dailyIntransit55" min="0" step="1" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" /></div>
                                </div>
                                <label style="display:flex;align-items:center;gap:6px;margin-top:8px;cursor:pointer"><input type="checkbox" @bind="dailyOpnameEnabled55" /> <span class="sm-label-caps">Stok Opname</span></label>
                                <input type="number" class="sm-frame" @bind="dailyOpname55" step="1" disabled="@(!dailyOpnameEnabled55)" style="width:100%;padding:8px;margin-top:4px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:@(dailyOpnameEnabled55 ? "var(--sm-surface-bright)" : "var(--sm-surface-container)")" />
                            </div>
                            <div style="border:1px solid var(--sm-outline-variant);border-radius:var(--sm-radius);padding:10px">
                                <div class="sm-label-caps" style="margin-bottom:8px"><span class="sm-chip chip-12"><span class="dot"></span>12 kg</span></div>
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                                    <div><label class="sm-label-caps" style="display:block;margin-bottom:4px">Stok Terjual (Tabung)</label><input type="number" class="sm-frame" @bind="dailyTerjual12" min="0" step="1" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" /></div>
                                    <div><label class="sm-label-caps" style="display:block;margin-bottom:4px">Stok Intransit</label><input type="number" class="sm-frame" @bind="dailyIntransit12" min="0" step="1" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" /></div>
                                </div>
                                <label style="display:flex;align-items:center;gap:6px;margin-top:8px;cursor:pointer"><input type="checkbox" @bind="dailyOpnameEnabled12" /> <span class="sm-label-caps">Stok Opname</span></label>
                                <input type="number" class="sm-frame" @bind="dailyOpname12" step="1" disabled="@(!dailyOpnameEnabled12)" style="width:100%;padding:8px;margin-top:4px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:@(dailyOpnameEnabled12 ? "var(--sm-surface-bright)" : "var(--sm-surface-container)")" />
                            </div>
                            <div style="border:1px solid var(--sm-outline-variant);border-radius:var(--sm-radius);padding:10px">
                                <div class="sm-label-caps" style="margin-bottom:8px"><span class="sm-chip chip-50"><span class="dot"></span>50 kg</span></div>
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                                    <div><label class="sm-label-caps" style="display:block;margin-bottom:4px">Stok Terjual (Tabung)</label><input type="number" class="sm-frame" @bind="dailyTerjual50" min="0" step="1" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" /></div>
                                    <div><label class="sm-label-caps" style="display:block;margin-bottom:4px">Stok Intransit</label><input type="number" class="sm-frame" @bind="dailyIntransit50" min="0" step="1" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" /></div>
                                </div>
                                <label style="display:flex;align-items:center;gap:6px;margin-top:8px;cursor:pointer"><input type="checkbox" @bind="dailyOpnameEnabled50" /> <span class="sm-label-caps">Stok Opname</span></label>
                                <input type="number" class="sm-frame" @bind="dailyOpname50" step="1" disabled="@(!dailyOpnameEnabled50)" style="width:100%;padding:8px;margin-top:4px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:@(dailyOpnameEnabled50 ? "var(--sm-surface-bright)" : "var(--sm-surface-container)")" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
                            <div><label class="sm-label-caps" style="display:block;margin-bottom:4px">Stok Terjual (Kiloliter)</label><input type="number" class="sm-frame" @bind="dailyTerjualMinyak" min="0" step="0.1" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" /></div>
                            <div><label class="sm-label-caps" style="display:block;margin-bottom:4px">Stok Intransit (Kiloliter)</label><input type="number" class="sm-frame" @bind="dailyIntransitMinyak" min="0" step="0.1" style="width:100%;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" /></div>
                        </div>
                        <label style="display:flex;align-items:center;gap:6px;margin-bottom:12px;cursor:pointer"><input type="checkbox" @bind="dailyOpnameEnabledMinyak" /> <span class="sm-label-caps">Stok Opname (± Kiloliter)</span></label>
                        <input type="number" class="sm-frame" @bind="dailyOpnameMinyak" step="0.1" disabled="@(!dailyOpnameEnabledMinyak)" style="width:100%;padding:8px;margin-bottom:12px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:@(dailyOpnameEnabledMinyak ? "var(--sm-surface-bright)" : "var(--sm-surface-container)")" />
                    }

                    <div style="margin-bottom:12px">
                        <label class="sm-label-caps" style="display:block;margin-bottom:6px">Keterangan</label>
                        <input type="text" class="sm-frame" @bind="dailyKeterangan" style="width:100%;padding:10px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                    </div>
                    @if (!string.IsNullOrEmpty(dailyFormMessage))
                    {
                        <div style="padding:10px;border-radius:var(--sm-radius);background:var(--sm-error-container);color:var(--sm-on-error-container)">@dailyFormMessage</div>
                    }
                }
            </div>
            <div class="sm-modal-footer">
                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="CloseUpdateModal">Batal</button>
                <button class="sm-btn sm-btn-primary sm-btn-sm" @onclick="SaveUpdate">Simpan Perubahan</button>
            </div>
        </div>
    </div>
}

@if (showTransferModal)
{
    <div class="sm-modal-backdrop"></div>
    <div style="position:fixed;inset:0;z-index:120;display:flex;align-items:center;justify-content:center">
        <div class="sm-modal" style="max-width:520px">
            <div class="sm-modal-header">
                <h3 class="sm-title-sm" style="margin:0">Kirim ke Agen</h3>
                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="CloseTransferModal">
                    <span class="material-symbols-outlined" style="font-size:18px">close</span>
                </button>
            </div>
            <div class="sm-modal-body">
                <div style="margin-bottom:12px">
                    <label class="sm-label-caps" style="display:block;margin-bottom:6px">Agen tujuan</label>
                    <select class="sm-filter" style="width:100%" @bind="selectedAgenIndex">
                        @for (var i = 0; i < agenTargets.Count; i++)
                        {
                            <option value="@i">@agenTargets[i].Nama</option>
                        }
                    </select>
                </div>

                <div class="sm-label-caps" style="margin-bottom:8px">Kuantitas per jenis material</div>
                <div style="display:flex;flex-direction:column;gap:10px">
                    @if (IsGas)
                    {
                        <div style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center">
                            <span class="sm-body-md">LPG 5.5 kg <span style="color:var(--sm-on-surface-variant)">(stok gudang: @FormatStok(GudangStok55))</span></span>
                            <input type="number" min="0" step="1" @bind="qty55" style="width:120px;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                        </div>
                        <div style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center">
                            <span class="sm-body-md">LPG 12 kg <span style="color:var(--sm-on-surface-variant)">(stok gudang: @FormatStok(GudangStok12))</span></span>
                            <input type="number" min="0" step="1" @bind="qty12" style="width:120px;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                        </div>
                        <div style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center">
                            <span class="sm-body-md">LPG 50 kg <span style="color:var(--sm-on-surface-variant)">(stok gudang: @FormatStok(GudangStok50))</span></span>
                            <input type="number" min="0" step="1" @bind="qty50" style="width:120px;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                        </div>
                    }
                    else
                    {
                        <div style="display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center">
                            <span class="sm-body-md">Minyak Tanah <span style="color:var(--sm-on-surface-variant)">(stok gudang: @FormatStok(GudangStokMinyak) KL)</span></span>
                            <input type="number" min="0" step="0.1" @bind="qtyMinyak" style="width:120px;padding:8px;border-radius:var(--sm-radius);border:1px solid var(--sm-outline-variant);background:var(--sm-surface-bright)" />
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(transferMessage))
                {
                    <div style="margin:14px 0 0;padding:10px;border-radius:var(--sm-radius);background:var(--sm-error-container);color:var(--sm-on-error-container)">@transferMessage</div>
                }
            </div>
            <div class="sm-modal-footer">
                <button class="sm-btn sm-btn-outline sm-btn-sm" @onclick="CloseTransferModal">Batal</button>
                <button class="sm-btn sm-btn-primary sm-btn-sm" @onclick="ConfirmTransfer">Kirim</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Wilayah { get; set; }

    [Parameter] public string? Produk { get; set; }

    private SalesAreaDetail? detail;
    private bool showUpdateModal;
    private string updateMode = "restock";
    private int selectedEntityIndex;
    private decimal restockQty;
    private DateTime restockDate = DateTime.Today;
    private Tier dailyTier = Tier.GudangWilayah;
    private decimal dailyTerjual55, dailyOpname55, dailyIntransit55;
    private bool dailyOpnameEnabled55;
    private decimal dailyTerjual12, dailyOpname12, dailyIntransit12;
    private bool dailyOpnameEnabled12;
    private decimal dailyTerjual50, dailyOpname50, dailyIntransit50;
    private bool dailyOpnameEnabled50;
    private decimal dailyTerjualMinyak, dailyOpnameMinyak, dailyIntransitMinyak;
    private bool dailyOpnameEnabledMinyak;
    private string? dailyKeterangan;
    private string? dailyFormMessage;

    private bool showTransferModal;
    private List<AgenTransferTargetRow> agenTargets = new();
    private int selectedAgenIndex;
    private decimal qty55, qty12, qty50, qtyMinyak;
    private decimal GudangStok55, GudangStok12, GudangStok50, GudangStokMinyak;
    private string? transferMessage;

    private string WilayahDisplay => Wilayah ?? "";
    private string ProdukDisplay => _isLpg ? "Gas Tabung" : (_produk?.DisplayName() ?? Produk ?? "");
    private string Satuan => _produk?.Satuan() ?? "-";
    private bool IsGas => _produk is not null && _produk != Domain.Entities.Produk.MinyakTanah;

    private Domain.Entities.Wilayah? _wilayah;
    private Domain.Entities.Produk? _produk;
    private bool _isLpg;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _wilayah = Enum.TryParse<Domain.Entities.Wilayah>(Wilayah, out var w) ? w : null;
        _isLpg = string.Equals(Produk, "Lpg", StringComparison.OrdinalIgnoreCase);
        _produk = _isLpg
            ? Domain.Entities.Produk.Lpg5_5Kg
            : (Enum.TryParse<Domain.Entities.Produk>(Produk, out var p) ? p : null);
        if (_wilayah is null || _produk is null)
        {
            return;
        }

        detail = _isLpg
            ? await Dashboard.GetLpgDetailAsync(_wilayah.Value)
            : await Dashboard.GetDetailAsync(_wilayah.Value, _produk.Value);
        if (detail is not null)
        {
            selectedEntityIndex = 0;
        }
    }

    private void OpenUpdateModal()
    {
        dailyTier = detail?.Rows.Select(r => r.Tier).Distinct().FirstOrDefault() ?? Tier.GudangWilayah;
        dailyTerjual55 = 0; dailyOpnameEnabled55 = false; dailyOpname55 = 0; dailyIntransit55 = 0;
        dailyTerjual12 = 0; dailyOpnameEnabled12 = false; dailyOpname12 = 0; dailyIntransit12 = 0;
        dailyTerjual50 = 0; dailyOpnameEnabled50 = false; dailyOpname50 = 0; dailyIntransit50 = 0;
        dailyTerjualMinyak = 0; dailyOpnameEnabledMinyak = false; dailyOpnameMinyak = 0; dailyIntransitMinyak = 0;
        dailyKeterangan = null; dailyFormMessage = null;
        showUpdateModal = true;
    }

    private async Task OpenTransferModal()
    {
        if (_wilayah is null)
        {
            return;
        }

        if (IsGas)
        {
            var lpg = await Dashboard.GetLpgRowsAsync();
            var rows = lpg.Where(r => r.Wilayah == _wilayah.Value).ToList();
            GudangStok55 = rows.FirstOrDefault(r => r.Produk == Domain.Entities.Produk.Lpg5_5Kg)?.StokGudang ?? 0;
            GudangStok12 = rows.FirstOrDefault(r => r.Produk == Domain.Entities.Produk.Lpg12Kg)?.StokGudang ?? 0;
            GudangStok50 = rows.FirstOrDefault(r => r.Produk == Domain.Entities.Produk.Lpg50Kg)?.StokGudang ?? 0;
        }
        else
        {
            var minyak = await Dashboard.GetMinyakTanahRowsAsync();
            GudangStokMinyak = minyak.FirstOrDefault(r => r.Wilayah == _wilayah.Value)?.StokGudang ?? 0;
        }

        agenTargets = (await Dashboard.GetAgenTransferTargetsAsync(_wilayah.Value)).ToList();
        if (agenTargets.Count == 0)
        {
            transferMessage = "Belum ada agen terdaftar di wilayah ini.";
            return;
        }

        selectedAgenIndex = 0;
        qty55 = 0; qty12 = 0; qty50 = 0; qtyMinyak = 0;
        transferMessage = null;
        showTransferModal = true;
    }

    private void CloseTransferModal()
    {
        showTransferModal = false;
        transferMessage = null;
    }

    private async Task ConfirmTransfer()
    {
        if (_wilayah is null || agenTargets.Count == 0)
        {
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var target = agenTargets[selectedAgenIndex];
        var qty = new Dictionary<Produk, decimal>();
        if (IsGas)
        {
            if (qty55 > 0) qty[Domain.Entities.Produk.Lpg5_5Kg] = qty55;
            if (qty12 > 0) qty[Domain.Entities.Produk.Lpg12Kg] = qty12;
            if (qty50 > 0) qty[Domain.Entities.Produk.Lpg50Kg] = qty50;
        }
        else
        {
            if (qtyMinyak > 0) qty[Domain.Entities.Produk.MinyakTanah] = qtyMinyak;
        }

        try
        {
            await Agen.TransferFromWarehouseAsync(state.User, _wilayah.Value, target.AgenId, qty, catatan: $"Transfer dari Gudang Wilayah {_wilayah.Value.DisplayName()} ke {target.Nama}");
            CloseTransferModal();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            transferMessage = ex.Message;
        }
    }

    private void SetModeRestock() => updateMode = "restock";

    private void SetModeDaily() => updateMode = "daily";

    private void CloseUpdateModal()
    {
        showUpdateModal = false;
        dailyFormMessage = null;
    }

    private async Task SaveUpdate()
    {
        if (detail is null || _produk is null || _wilayah is null)
        {
            return;
        }

        var state = await AuthStateProvider.GetAuthenticationStateAsync();

        if (updateMode == "restock")
        {
            var row = detail.Rows[selectedEntityIndex];
            if (restockQty <= 0)
            {
                return;
            }

            try
            {
                await StockWrite.TransactAsync(state.User, row.StokEntitasId, StockTransactionType.Receive, restockQty, catatan: "Isi ulang stok");
            }
            catch (Exception ex)
            {
                dailyFormMessage = ex.Message;
                return;
            }

            CloseUpdateModal();
            await LoadAsync();
            return;
        }

        // daily — perukuran (Terjual via Issue, Opname via Adjust, Intransit/Keterangan via UpdateDetail)
        var entries = new List<(Domain.Entities.Produk Produk, decimal Terjual, bool OpEnabled, decimal Opname, decimal Intransit)>();
        if (IsGas)
        {
            entries.Add((Domain.Entities.Produk.Lpg5_5Kg, dailyTerjual55, dailyOpnameEnabled55, dailyOpname55, dailyIntransit55));
            entries.Add((Domain.Entities.Produk.Lpg12Kg, dailyTerjual12, dailyOpnameEnabled12, dailyOpname12, dailyIntransit12));
            entries.Add((Domain.Entities.Produk.Lpg50Kg, dailyTerjual50, dailyOpnameEnabled50, dailyOpname50, dailyIntransit50));
        }
        else
        {
            entries.Add((Domain.Entities.Produk.MinyakTanah, dailyTerjualMinyak, dailyOpnameEnabledMinyak, dailyOpnameMinyak, dailyIntransitMinyak));
        }

        try
        {
            foreach (var (produk, terjual, opEnabled, opname, intransit) in entries)
            {
                var row = detail.Rows.FirstOrDefault(r => r.Tier == dailyTier && r.Produk == produk);
                if (row is null)
                {
                    continue;
                }

                var perluIntransit = intransit != (row.StokIntransit ?? 0m);
                var perluKeterangan = !string.IsNullOrWhiteSpace(dailyKeterangan);
                if (perluIntransit || perluKeterangan)
                {
                    await StockWrite.UpdateDetailAsync(state.User, row.StokEntitasId, new UpdateDetailRequest
                    {
                        DOT = row.DOT,
                        TanggalStokAwal = row.TanggalStokAwal,
                        StokHabisTerjual = row.StokHabisTerjual,
                        StokIntransit = intransit,
                        Keterangan = dailyKeterangan,
                    });
                }

                if (terjual > 0)
                {
                    await StockWrite.TransactAsync(state.User, row.StokEntitasId, StockTransactionType.Issue, terjual, catatan: dailyKeterangan ?? "Stok terjual harian");
                }

                if (opEnabled && opname != 0)
                {
                    await StockWrite.TransactAsync(state.User, row.StokEntitasId, StockTransactionType.Adjust, opname, catatan: $"Opname {dailyKeterangan ?? ""}".Trim());
                }
            }

            CloseUpdateModal();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            dailyFormMessage = ex.Message;
        }
    }

    private static string FormatKl(decimal value) => value.ToString("0.###");

    private static string FormatStok(decimal value) => value.ToString("N0");

    private static string StatusText(Status? status) => status switch
    {
        Status.Aman => "Aman",
        Status.Warning => "Warning",
        Status.Kritis => "Kritis",
        _ => "-",
    };

    private static MarkupString StatusPill(Status? status)
    {
        var (label, css) = status switch
        {
            Status.Aman => ("Aman", "sm-pill sm-pill-success"),
            Status.Warning => ("Warning", "sm-pill sm-pill-warning"),
            Status.Kritis => ("Kritis", "sm-pill sm-pill-danger"),
            _ => ("-", "sm-pill sm-pill-neutral"),
        };
        return new MarkupString($"<span class=\"{css}\">{label}</span>");
    }
}
