@using Microsoft.AspNetCore.Identity
@using StockMonitorTso.Infrastructure.Persistence

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        <div style="padding:8px 16px">
            <div class="sm-label-caps" style="margin-bottom:4px">Role aktif</div>
            <select class="sm-filter" style="width:100%" value="@currentRole" @onchange="OnRoleChanged">
                @foreach (var role in availableRoles)
                {
                    <option value="@role">@role</option>
                }
            </select>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private string? currentRole;
    private IList<string> availableRoles = new List<string>();

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = state.User;
        if (userPrincipal.Identity?.IsAuthenticated != true)
        {
            availableRoles = new List<string>();
            currentRole = null;
            return;
        }

        var user = await UserManager.GetUserAsync(userPrincipal);
        if (user is null)
        {
            return;
        }

        availableRoles = await UserManager.GetRolesAsync(user);
        currentRole = user.ActiveRoleName ?? userPrincipal.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
            ?? availableRoles.FirstOrDefault();
    }

    private async Task OnRoleChanged(ChangeEventArgs e)
    {
        var newRole = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(newRole) || newRole == currentRole)
        {
            return;
        }

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(state.User);
        if (user is null)
        {
            return;
        }

        user.ActiveRoleName = newRole;
        await UserManager.UpdateAsync(user);
        await SignInManager.RefreshSignInAsync(user);
        NavigationManager.Refresh(forceReload: true);
    }
}
