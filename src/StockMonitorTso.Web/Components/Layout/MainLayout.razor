@inherits LayoutComponentBase

<div class="sm-shell">
    <aside class="sm-sidebar">
        <div class="sm-sidebar-brand">
            <span class="material-symbols-outlined" style="font-size:22px;color:var(--sm-primary-container)">monitoring</span>
            <span>Stock Monitor &amp; TSO</span>
        </div>
        <NavMenu />
    </aside>

    <div class="sm-main">
        <div class="sm-topbar">
            <span class="sm-body-md" style="color:var(--sm-on-surface-variant)">Dashboard</span>
            <AuthorizeView>
                <Authorized>
                    <span class="sm-pill sm-pill-neutral" style="gap:8px">
                        <span style="width:8px;height:8px;border-radius:50%;background:var(--sm-primary-fixed)"></span>
                        @context.User.Identity?.Name
                    </span>
                </Authorized>
            </AuthorizeView>
        </div>
        <main class="sm-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">x</a>
</div>
