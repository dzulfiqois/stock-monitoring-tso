@using Microsoft.AspNetCore.Authorization

@inject NavigationManager NavigationManager

<nav class="sm-nav">
    <NavLink class="sm-nav-item" href="" Match="NavLinkMatch.All" ActiveClass="active">
        <span class="material-symbols-outlined">dashboard</span> Ringkasan Dashboard
    </NavLink>
    <NavLink class="sm-nav-item" href="gudang-wilayah" ActiveClass="active">
        <span class="material-symbols-outlined">factory</span> Gudang Wilayah
    </NavLink>
    <NavLink class="sm-nav-item" href="tso" ActiveClass="active">
        <span class="material-symbols-outlined">local_shipping</span> Transport Shipping Order
    </NavLink>
    <AuthorizeView Roles="Superadmin">
        <Authorized>
            <NavLink class="sm-nav-item" href="mitra" ActiveClass="active">
                <span class="material-symbols-outlined">handshake</span> Mitra TSO
            </NavLink>
        </Authorized>
    </AuthorizeView>
    <NavLink class="sm-nav-item" href="sales-area/register" ActiveClass="active">
        <span class="material-symbols-outlined">add_business</span> Register Sales Area
    </NavLink>

    <AuthorizeView Roles="Superadmin">
        <Authorized>
            <NavLink class="sm-nav-item" href="admin/users" ActiveClass="active">
                <span class="material-symbols-outlined">manage_accounts</span> Manajemen User
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <div style="flex:1"></div>

    <AuthorizeView>
        <Authorized>
            <ActiveRoleSwitcher @rendermode="InteractiveServer" />
            <NavLink class="sm-nav-item" href="Account/Manage">
                <span class="material-symbols-outlined">account_circle</span> @context.User.Identity?.Name
            </NavLink>
            <form action="Account/Logout" method="post" style="display:contents">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@NavigationManager.ToBaseRelativePath(NavigationManager.Uri)" />
                <button type="submit" class="sm-nav-item" style="width:100%;background:none;border:none;text-align:left">
                    <span class="material-symbols-outlined">logout</span> Logout
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <NavLink class="sm-nav-item" href="" Match="NavLinkMatch.All" ActiveClass="active">
                <span class="material-symbols-outlined">login</span> Login
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>
