# Salin ke `.env` lalu isi bila perlu (JANGAN commit `.env`).
# Semua nilai opsional; app punya default seed (lihat SeedData.cs).
ASPNETCORE_ENVIRONMENT=Production
Seed__DefaultPassword=
Seed__SuperadminEmail=superadmin@stockmonitor.local
Seed__OperatorEmail=operator@stockmonitor.local
Seed__SupervisiEmail=supervisi@stockmonitor.local
Seed__TamuEmail=tamu@stockmonitor.local
Seed__MultiRoleEmail=multi@stockmonitor.local
# Path seeds (wajib bila keluar dari /app): Seed__MitraPath=/app/seeds/mitra-tso.json

# --- Post-rekonstruksi (compose api + postgres + nginx) ---
# Wajib di produksi: kunci signing JWT, minimal 32 karakter acak.
# Contoh generate: openssl rand -base64 48
JWT_KEY=
# true = lewati seed stok (workbook tidak ada di repo); default false
SEED_SKIP_STOCK=
# Alamat publik app di balik proxy TLS (mis. https://monitor.example.com) — pin scheme/host
# untuk redirect auth, cookie secure, dan URL absolut. Kosong = ikut X-Forwarded-* dari proxy.
APP_BASE_URL=

# --- Frontend (frontend/, hanya untuk dev di luar proxy; produksi same-origin via nginx) ---
# VITE_API_BASE_URL=http://localhost:8080