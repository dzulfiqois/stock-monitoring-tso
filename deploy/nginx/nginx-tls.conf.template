# Template konfigurasi nginx dengan TLS termination (produksi).
# 1. Generate sertifikat (self-signed dev): ./deploy/nginx/gen-dev-cert.sh
#    Produksi: gunakan sertifikat resmi (mis. Let's Encrypt), letakkan di /etc/nginx/certs/.
# 2. Rename file ini menjadi nginx.conf (atau mount sebagai default.conf).
# 3. docker compose up -d --force-recreate nginx

server {
    listen 80;
    server_name _;
    # Redirect semua trafik http -> https
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # Kritis: agar backend tahu request asli https (redirect auth & cookie Secure tidak downgrade)
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/ {
        proxy_pass http://api:8080;
    }

    location = /ready {
        proxy_pass http://api:8080/ready;
    }

    location = /health {
        proxy_pass http://api:8080/health;
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
